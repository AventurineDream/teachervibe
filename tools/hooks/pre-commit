#!/usr/bin/env bash
# Added-line comment ownership gate adapted from the Aven standard hook template.
# Git invokes this without arguments to inspect staged source changes, not unstaged work.
# CI uses: bash tools/hooks/pre-commit --base <revision> (merge-base through HEAD).
# Requires Bash and Git only; no environment variables or network access. Exits 1 for
# an ownerless reminder, 2 for invalid usage, or Git's failure code for invalid revisions.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if (($# == 0)); then
  comparison=(--cached)
elif (($# == 2)) && [[ "$1" == --base ]]; then
  comparison=("$2...HEAD")
else
  echo "Usage: tools/hooks/pre-commit [--base <revision>]" >&2
  exit 2
fi

# Inspect only additions, so untouched legacy reminders do not block adoption.
# Restrict the rule to source: documentation may quote noncompliant examples.
changes=$(git diff "${comparison[@]}" --unified=0 --diff-filter=ACMR -- \
  '*.py' '*.ts' '*.tsx' '*.js' '*.mjs' '*.cjs' '*.gd' '*.swift' '*.sh' '*.sql')
if printf '%s\n' "$changes" \
  | grep -E '^\+.*\b(TODO|FIXME|HACK)\b' \
  | grep -vE '\b(TODO|FIXME|HACK)\([a-z0-9-]+(, [0-9]{4}-[0-9]{2}-[0-9]{2})?\):'; then
  echo "FAIL: added source reminder lacks an owner; use TODO(owner): description." >&2
  exit 1
fi
